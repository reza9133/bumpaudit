# Optional. Without a key the scripts generate a throw-away one and fund it on Studionet.
BA_PRIVATE_KEY=
# Reuse an existing deployment instead of deploying a new contract.
BA_CONTRACT_ADDRESS=
# Folder (URL) that serves examples/fixtures/CHANGELOG.md, e.g. a raw.githubusercontent.com folder of your repo.
BA_FIXTURE_BASE=
# Live E2E (npm run test:live): run a smaller sample of the adversarial tables (about 15 reverts instead of ~50).
BA_E2E_QUICK=
# Live E2E: where the reports go (default ./reports).
BA_E2E_REPORT_DIR=
